#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
# pg-config.env — Shared PostgreSQL Configuration
#
# Single source of truth for PostgreSQL version and shared settings.
# Sourced by all install/uninstall/management scripts in this directory.
#
# Priority (highest → lowest):
#   1. CLI argument         ./install.sh 17          one-off override
#   2. Shell env variable   export PG_VERSION=17      Docker/CI injection
#   3. This file            PG_VERSION=13             team default  ← edit here
#   4. Script default       16                        last resort fallback
#
# Docker Compose usage (two options):
#   env_file:
#     - ./app/psql/psql-ubuntu2404/install-postgres/pg-config.env
#   -- OR --
#   environment:
#     - PG_VERSION=13
#
# Date: Sat 2026Apr04
# Author: devesplabs
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-

# PostgreSQL major version to install/uninstall
PG_VERSION=13
